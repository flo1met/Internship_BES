library(tidyverse)
library(ggdist)
library(ggthemes)
library(tidyquant)
load("../data/Sim_4.RData")
####### FIX CODING MISTAKE, ONLY THIS RUN, CORRECTED IN SIM######
Sim_4 <- Sim_4 %>%
mutate(
BESu = prod(PMP1u_h_p1, PMP1u_h_p2, PMP1u_h_p3) / (
prod(PMP1u_h_p1, PMP1u_h_p2, PMP1u_h_p3) + prod(1 - PMP1u_h_p1, 1 - PMP1u_h_p2, 1 -
PMP1u_h_p3)
))
Sim_4$n_sample <- Sim_4$n_sample*3
# Add indicator or partial
Sim_4$ind_p_all <- ifelse(Sim_4$ind_p1 == 1 & Sim_4$ind_p2 == 1 & Sim_4$ind_p1 == 1, 1, 0)
Sim_4_agg <- Sim_4 %>%
group_by(n_sample, c, d) %>%
summarise(PMP1u_H = mean(PMP1u_H),
PMP1c_H = mean(PMP1c_H),
BESc = mean(BESc),
BESu = mean(BESu))
Sim_4_agg %>% ggplot() +
geom_line(aes(
x = as.factor(n_sample),
y = PMP1c_H,
linetype = "Complete",
color = as.factor(d),
group = 1
)) +
geom_line(aes(
x = as.factor(n_sample),
y = BESc,
linetype = "Partial",
color = as.factor(d),
group = 1
)) +
scale_linetype_manual(name = "Hypothesis",
values = c("Complete" = "solid", "Partial" = "longdash")) +
#geom_hline(yintercept = 8/(8+1), color = "black", linetype = "dotted", alpha = 0.5) +
labs(x = "Sample Size", y = "Posterior Model Probabilities") +
ggtitle("Comparison PMPs BES and complete Hypothesis against the Complement") +
scale_color_discrete(guide = "none") +
theme_bw() +
facet_grid(c ~ d) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
Sim_4_agg %>% ggplot() +
geom_line(aes(
x = as.factor(n_sample),
y = PMP1u_H,
linetype = "Complete",
color = as.factor(d),
group = 1
)) +
geom_line(aes(
x = as.factor(n_sample),
y = BESu,
linetype = "Partial",
color = as.factor(d),
group = 1
)) +
scale_linetype_manual(name = "Hypothesis",
values = c("Complete" = "solid", "Partial" = "longdash")) +
geom_hline(yintercept = 8/(8+1), color = "black", linetype = "dotted", alpha = 0.5) +
geom_hline(yintercept = 24/(24+1), color = "grey", linetype = "dotted", alpha = 0.5) +
labs(x = "Sample Size", y = "Posterior Model Probabilities") +
ggtitle("Comparison PMPs BES and complete Hypothesis against the Unconstrained") +
scale_color_discrete(guide = "none") +
theme_bw() +
facet_grid(c ~ d) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
Sim_4 %>%
filter(n_sample %in% c(75, 150, 300, 1500) & c == 0.2 & d == 0.2) %>%
ggplot(aes(y = factor(n_sample), x = BESc, fill = factor(ind_comp))) +
geom_boxplot(
width = 0.12,
# removing outliers
outlier.color = NA,
alpha = 0.5
) +
stat_dots(
# ploting on left side
side = "right",
# adjusting position
justification = 1.2,
# adjust grouping (binning) of observations
#binwidth = 0.25
alpha = 0.2
) +
# Themes and Labels
scale_fill_tq() +
theme_tq() +
labs(
title = "Bayesian Evidence Synthesis against Complement",
x = "Posterior Model Probabilities against Complement",
y = "",
fill = "Hypothesis Indicator"
) +
facet_wrap(~ n_sample, scales = "free") +
theme(
axis.ticks.y = element_blank(),
axis.text.y = element_blank())
